# ==============================================================================
# NOVALIVE ENVIRONMENT CONFIGURATION (FULL UPPERCASE)
# ==============================================================================

# Database (PostgreSQL)
POSTGRES_DB=novalive_db
POSTGRES_USER=nova_user
POSTGRES_PASSWORD=change_me_strong_postgres_password
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# MinIO (S3 Object Storage)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Authentication Secrets (Tối thiểu 32 ký tự)
JWT_SECRET=change_me_jwt_secret_at_least_32_characters_long
OTP_PEPPER=change_me_otp_pepper_at_least_32_characters_long

# Email Integration (Resend API Key & Sender)
EMAIL_API_KEY=re_your_resend_api_key_here
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# GHN Shipping Integration Secrets
GHN_API_TOKEN=your_ghn_api_token_here
GHN_SHOP_ID=0
GHN_WEBHOOK_SECRET=your_ghn_webhook_secret_here

# Agora RTC Livestream Secrets (32 hex characters each)
AGORA_APP_ID=your_agora_app_id_32_chars_hex
AGORA_APP_CERTIFICATE=your_agora_app_certificate_32_chars_hex
AGORA_TOKEN_TTL_SECONDS=7200
