# Database
POSTGRES_DB=novalive_db
POSTGRES_USER=nova_user
POSTGRES_PASSWORD=change_me_strong_postgres_password
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# MinIO (S3 Object Storage)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Full trusted KYC bucket prefix used to validate shop registration documents
KYC_URLS__ALLOWED_PREFIXES__0=https://cdn.novalive.vn/kyc-docs/

# Auth Secrets (JWT & OTP Pepper >= 32 ký tự)
JWT_SECRET=change_me_jwt_secret_at_least_32_characters_long
OTP_PEPPER=change_me_otp_pepper_at_least_32_characters_long

# Email (Resend)
EMAIL_API_KEY=re_your_resend_api_key_here
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# Vận chuyển GHN
GHN_API_TOKEN=your_ghn_api_token_here
GHN_SHOP_ID=0
GHN_WEBHOOK_SECRET=your_ghn_webhook_secret_here

# Agora RTC Livestream (32 hex chars)
AGORA_APP_ID=your_agora_app_id_32_chars_hex
AGORA_APP_CERTIFICATE=your_agora_app_certificate_32_chars_hex
AGORA_TOKEN_TTL_SECONDS=7200

# Cổng thanh toán MoMo
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=your_momo_access_key_here
MOMO_SECRET_KEY=your_momo_secret_key_here
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=https://novalive.vn/orders/payment-result
MOMO_IPN_URL=https://api.novalive.vn/api/v1/payments/webhook/momo

# Cổng chuyển khoản VietQR
VIETQR_BANK_BIN=970422
VIETQR_ACCOUNT_NUMBER=0000123456789
VIETQR_ACCOUNT_NAME=CONG TY NOVALIVE
VIETQR_CLIENT_ID=your_vietqr_client_id_here
VIETQR_API_KEY=
VIETQR_WEBHOOK_SECRET=your_vietqr_webhook_secret_here
VIETQR_BASE_URL=https://api.vietqr.vn
