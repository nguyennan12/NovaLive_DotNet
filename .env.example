# ==============================================================================
# NOVALIVE ENVIRONMENT CONFIGURATION (SAMPLE)
# Bản mẫu cấu hình biến môi trường toàn hệ thống NovaLive
# Sao chép file này thành .env và điền các giá trị thực tế của môi trường
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CƠ SỞ DỮ LIỆU CHÍNH (PostgreSQL 17)
# Lưu ý: Docker chỉ tạo mật khẩu này khi volume khởi tạo lần đầu tiên.
# Nếu đổi mật khẩu sau khi đã chạy Docker, cần chạy "docker compose down -v" để áp dụng.
# ------------------------------------------------------------------------------
POSTGRES_DB=novalive_db
POSTGRES_USER=nova_user
POSTGRES_PASSWORD=change_me_strong_postgres_password
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. BỘ NHỚ ĐỆM & KHÓA PHÂN TÁN (Redis 7)
# Dùng cho Caching dữ liệu, Idempotency key, Token Blacklist và Rate Limiting
# ------------------------------------------------------------------------------
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 3. MESSAGE BROKER (RabbitMQ 3.13)
# Dùng cho giao tiếp bất đồng bộ qua MassTransit (xử lý outbox, sự kiện đơn hàng, thanh toán)
# ------------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ------------------------------------------------------------------------------
# 4. KHO LƯU TRỮ TẬP TIN S3 (MinIO Object Storage)
# Lưu trữ ảnh sản phẩm, video livestream, tài liệu xác thực KYC shop
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ------------------------------------------------------------------------------
# 5. BẢO MẬT XÁC THỰC (JWT & OTP)
# Bắt buộc độ dài tối thiểu 32 ký tự để đảm bảo an toàn HMAC-SHA256
# ------------------------------------------------------------------------------
# Khóa bí mật dùng để ký và xác thực JSON Web Token
JWT_SECRET=change_me_jwt_secret_at_least_32_characters_long

# Chuỗi muối (Pepper) tăng cường bảo mật khi băm mã OTP xác thực email / đăng nhập
OTP_PEPPER=change_me_otp_pepper_at_least_32_characters_long

# ------------------------------------------------------------------------------
# 6. DỊCH VỤ GỬI EMAIL (Resend API)
# Gửi mã OTP xác minh đăng ký, thông báo trạng thái đơn hàng
# ------------------------------------------------------------------------------
EMAIL_API_KEY=re_your_resend_api_key_here
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# ------------------------------------------------------------------------------
# 7. ĐƠN VỊ VẬN CHUYỂN (Giao Hàng Nhanh - GHN)
# Tính phí ship tự động, tạo vận đơn và nhận Webhook hành trình giao nhận
# ------------------------------------------------------------------------------
GHN_API_TOKEN=your_ghn_api_token_here
GHN_SHOP_ID=0
GHN_WEBHOOK_SECRET=your_ghn_webhook_secret_here

# ------------------------------------------------------------------------------
# 8. PHÁT TRỰC TIẾP VIDEO (Agora RTC Livestream)
# Tạo token phòng livestream cho Seller (Host phát) và Buyer (Khán giả xem)
# ------------------------------------------------------------------------------
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here
AGORA_TOKEN_TTL_SECONDS=7200

# ------------------------------------------------------------------------------
# 9. CỔNG THANH TOÁN VÍ MOMO (MoMo API v2)
# Khởi tạo liên kết thanh toán MoMo QR / App redirect và nhận Webhook IPN
# ------------------------------------------------------------------------------
# Mã đối tác tích hợp MoMo
MOMO_PARTNER_CODE=MOMO

# Khóa truy cập MoMo API (Dùng cho môi trường thử nghiệm Sandbox)
MOMO_ACCESS_KEY=your_momo_access_key_here

# Khóa bí mật MoMo dùng để ký chữ ký HMAC-SHA256 và xác thực IPN Webhook
MOMO_SECRET_KEY=your_momo_secret_key_here

# Endpoint MoMo API tạo giao dịch (Mặc định: Cổng Test Sandbox của MoMo)
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# URL chuyển hướng người mua về giao diện Web sau khi thanh toán trên MoMo
MOMO_REDIRECT_URL=https://novalive.vn/orders/payment-result

# URL callback IPN để MoMo gửi kết quả thanh toán ngầm về server Backend
MOMO_IPN_URL=https://api.novalive.vn/api/v1/payments/webhook/momo

# ------------------------------------------------------------------------------
# 10. CỔNG CHUYỂN KHOẢN NGÂN HÀNG (VietQR NAPAS 247)
# Tạo chuỗi mã VietQR chuẩn quốc gia và tiếp nhận Webhook đối soát số dư SePAY / Casso
# ------------------------------------------------------------------------------
# Mã BIN ngân hàng nhận tiền (970422: MBBank, 970415: VietinBank, ...)
VIETQR_BANK_BIN=970422

# Số tài khoản ngân hàng thụ hưởng nhận tiền mua hàng
VIETQR_ACCOUNT_NUMBER=0000123456789

# Tên chủ tài khoản in hoa không dấu
VIETQR_ACCOUNT_NAME=CONG TY NOVALIVE

# Thông tin xác thực tích hợp VietQR API (nếu dùng dịch vụ mở rộng của VietQR.vn)
VIETQR_CLIENT_ID=your_vietqr_client_id_here
VIETQR_API_KEY=

# Chữ ký bí mật xác thực Webhook đối soát biến động số dư từ cổng SePAY/Casso/Ngân hàng
VIETQR_WEBHOOK_SECRET=your_vietqr_webhook_secret_here

# URL API của hệ thống VietQR
VIETQR_BASE_URL=https://api.vietqr.vn
