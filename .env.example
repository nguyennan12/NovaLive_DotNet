# ASP.NET Core environment; __ maps to : in configuration keys.
ASPNETCORE_ENVIRONMENT=Development

# Session cookies: Secure=false is honored ONLY in Development; None always requires Secure.
# Leave Domain blank for host-only cookies. Access path=/, refresh path=/api/v1/auth.
Cookies__AccessTokenName=nova_at
Cookies__RefreshTokenName=nova_rt
Cookies__SameSite=Lax
Cookies__Secure=false
Cookies__Domain=

# Explicit frontend origins, no wildcard or trailing slash. FE must include credentials.
# Cookie POST refresh/logout/change-password also require X-Requested-With: XMLHttpRequest.
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://localhost:5173
Cors__AllowedOrigins__2=http://localhost:8080

# Email testing: Both logs OTP (opt-in) and sends real mail through Resend.
# OTPs in logs are sensitive. LogOtp defaults to false in appsettings.
# Production also requires AllowOtpLoggingInProduction=true; keep false normally.
# Before verifying a Resend domain, send ONLY to the Resend account owner's email
# and set Email__FromAddress=onboarding@resend.dev. Fill these two blank values locally.
Email__Provider=Both
Email__LogOtp=true
Email__AllowOtpLoggingInProduction=false
Email__ApiKey=
Email__FromAddress=
Email__FromName=NovaLive

# Authentication: replace blanks with random DEV-only strings (at least 32 bytes).
# Never reuse development secrets in production.
Jwt__Secret=
Jwt__Issuer=NovaLive
Jwt__Audience=NovaLiveClients
Otp__Pepper=

# PostgreSQL: container credentials below are DEV examples. Keep connection string in sync.
POSTGRES_DB=novalive_db
POSTGRES_USER=nova_user
POSTGRES_PASSWORD=nova_password
POSTGRES_PORT=5432
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=novalive_db;Username=nova_user;Password=nova_password

# Redis: use container hostname in Docker; localhost for a host-run API.
REDIS_PORT=6379
Redis__ConnectionString=redis:6379

# RabbitMQ: DEV credentials shared by the broker and API.
RabbitMQ__Host=rabbitmq
RabbitMQ__Username=guest
RabbitMQ__Password=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# MinIO (S3 object storage): DEV example credentials and host ports.
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# GHN shipping: optional for OTP testing; add sandbox credentials locally when needed.
Ghn__BaseUrl=https://dev-online-gateway.ghn.vn
Ghn__ApiToken=
Ghn__ShopId=0
Ghn__WebhookSecret=
Ghn__DefaultServiceTypeId=2
Ghn__TimeoutSeconds=15

