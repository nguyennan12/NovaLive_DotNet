# Enable only after OrderHub joins the JWT-owned shop without JoinShop(shopId).
VITE_SELLER_ORDER_HUB_AUTOJOIN=false
VITE_SOCKET_URL=http://localhost:5001
VITE_AGORA_APP_ID=
VITE_AGORA_APP_CERTIFICATE=
